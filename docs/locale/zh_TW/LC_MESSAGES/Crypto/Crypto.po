#: ../../Crypto/Crypto.rst:133 737f5f74529f452da38ae54c1e6bdcea
msgid "``PF_ECDH_CURVE_P256``"
msgstr "``PF_ECDH_CURVE_P256``"

#: ../../Crypto/Crypto.rst:134 4e6a452663d84c9eac9615a421d54edb
