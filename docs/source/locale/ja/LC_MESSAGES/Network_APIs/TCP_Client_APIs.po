#: ../../source/Network_APIs/TCP_Client_APIs.rst:578
#: 3d1b84c153974f14bdd57c17a892a158
msgid "``/quit``: closes the connection and exits the client."
msgstr "``/quit``: 接続を閉じてクライアントを終了します。"

#: ../../source/Network_APIs/TCP_Client_APIs.rst:579
#: ee6c762b67fa4e6d833c4a6e5c90dba3
msgid ""
"``/send_msg <message...>``: sends the second token of the line to the server"
" as a chat message."
msgstr ""

#: ../../source/Network_APIs/TCP_Client_APIs.rst:581
#: 50b34e795f4a4d1595f8a2f6c1ebfad5
msgid "``/file <file_path>``: sends a single file to the server."
msgstr "``/file <file_path>``: 単一のファイルをサーバーに送信します。"

#: ../../source/Network_APIs/TCP_Client_APIs.rst:582
#: d90b52a3886c48c1b86fe1d4a08adb11
#, fuzzy
msgid ""
"``/multiple_file <file1> <file2> ...``: sends multiple files to the server, "
"one thread per file, limited to ``max_thread_num`` at a time."
