#: 38b84b10fc4d492497c3e0b20cb9fe8c
msgid "``port``: Default is ``65432``"
msgstr "``ポート'': デフォルトは ``65432`` です"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:102
#: 3ccf25b3de4749a7ad73a1001fea86fb
msgid "``max_clients``: Default is ``10``"
msgstr "``max_clients``: デフォルトは ``10``"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:103
#: 63455575485f4a25b4d2d2b83803e6b8
msgid "``port_add_step``: Default is ``1``"
msgstr "``port_add_step``: デフォルトは ``1`` です"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:104
#: d8759c586e7143838c1ffe24c9fd6f62
msgid "``port_range_num``: Default is ``100``"
msgstr "``port_range_num``: デフォルトは ``100``"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:105
#: a8020929e0f14b5394b6dd502b7a7b67
msgid "``max_file_transfer_thread_num``: Default is ``10``"
msgstr "``max_file_transfer_thread_num``: デフォルトは ``10``"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:106
#: a9307e89f7cd471d96794bf7fbc9313c
msgid "``is_hand_alloc_port``: Default is ``False``"
msgstr "``is_hand_alloc_port``: デフォルトは ``False``"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:107
#: 76084a80a458455bb952e8acad677eba
msgid "``is_input_command_in_console``: Default is ``True``"
msgstr "``is_input_command_in_console``: デフォルトは ``True``"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:108
#: f32a6549330a43f482e01def905e7415
msgid "``max_custom_workers``: Default is ``10``"
msgstr "``max_custom_workers``: デフォルトは ``10``"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:109
#: b423cc46e39340b1aa792d44e0157b60
msgid ""
"``is_extend_command``: Default is ``False`` (when ``True``, ``__init__`` "
"will not call ``start_TCP_Server()`` automatically)"
msgstr ""
"``is_extend_command``: デフォルトは ``False`` (``True`` の場合、``__init__`` は自動的に "
"``start_TCP_Server()`` を呼び出しません)"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:111
#: 515932c230d64c88ab31d959cc694992
msgid ""
"``is_enable_encrypto``: Default is ``True`` (when ``True``, client "
"connections go through an RSA public-key exchange and all subsequent "
"messages are encrypted)"
msgstr ""
"``is_enable_encrypto``: デフォルトは ``True`` です (``True`` の場合、クライアント接続は RSA "
"公開鍵交換を経由し、後続のメッセージはすべて暗号化されます)"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:114
#: c259e80f53a14b79a94190bcded7b30d
msgid ""
"``is_custom_keys``: Default is ``None`` (a ``[pub_key_path, "
"pvt_key_path]`` list uses a user-supplied keypair instead of the default "
"``~/.ssh`` / generated keys)"
msgstr ""
"``is_custom_keys``: デフォルトは ``None`` (``[pub_key_path, pvt_key_path]`` "
"リストはデフォルトの ``~/.ssh`` / 生成されたキーの代わりにユーザー指定のキーペアを使用します)"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:117
#: a8020929e0f14b5394b6dd502b7a7b67
#, fuzzy
msgid "``recv_messages_chunk_len``: Default is ``4096``"
msgstr "``max_clients``: デフォルトは ``10``"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:118
#: a8020929e0f14b5394b6dd502b7a7b67
#, fuzzy
msgid "``file_transfer_chunk_len``: Default is ``65536`` (64 KiB)"
msgstr "``max_file_transfer_thread_num``: デフォルトは ``10``"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:119
#: 515932c230d64c88ab31d959cc694992
msgid ""
"``is_asynic_clients_io``: Default is ``False`` (when ``True``, every "
"accepted connection is served by a coroutine on one asyncio event loop, "
"and ``max_clients`` is ignored)"
msgstr ""
"'' is_asynic_clients_io ''：デフォルトは'' False ''です（ '' True "
"''の場合、受け入れられたすべての接続は1つの非同期イベントループのコルーチンによって提供され、'' max_clients ''は無視されます）"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:122
#: b423cc46e39340b1aa792d44e0157b60
msgid ""
"``is_debug``: Default is ``False`` (``True`` adds the execution-process "
"lines to the command/result lines)"
msgstr "'' is_debug '':デフォルトは'' False ''です('' True ''は実行プロセス行をコマンド/結果行に追加します)"

#: ../../source/Network_APIs/TCP_Server_APIs.rst:124
#: b423cc46e39340b1aa792d44e0157b60
