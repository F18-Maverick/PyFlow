msgstr "受信者は補完的な手順を実行します。"

#: ../../source/File_Transfer/File_Transfer.rst:102
#: 1353e95158fc496db86676f544168584
msgid "Send the start signal."
msgstr "スタート信号を送信します。"

#: ../../source/File_Transfer/File_Transfer.rst:103
#: e32e19b7ac2e4a20a76a7c5640212835
msgid "Read the 4-byte length, then the filename, then the 8-byte size."
msgstr "4 バイトの長さを読み取り、次にファイル名、次に 8 バイトのサイズを読み取ります。"

#: ../../source/File_Transfer/File_Transfer.rst:105
#: 1bbea38ba8ec4f84970f408827ba1be4
