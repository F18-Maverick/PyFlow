#: ../../source/api/PyFlow.transfer_web.setup_server.rst:2
#: 88492dfde47b4dbb914aaba07f359440
msgid "PyFlow.transfer\\_web.setup\\_server module"
msgstr ""

#: 103789700f8d41aa80e1cb374abb02a3 PyFlow.transfer_web.setup_server:1 of
msgid "PyFlow TCP server web launcher."
msgstr ""

#: 581fc0a8029c44f7998895401060a79b PyFlow.transfer_web.setup_server:3 of
msgid "Checks ``transfer_web/.Flow_Web/setup_server.json``:"
msgstr ""

#: 60412e56b0d44018bbc88cd258e2c48b PyFlow.transfer_web.setup_server:5 of
msgid ""
"missing  -> opens the server startup-configuration UI in the browser; the"
" UI saves the config (same shape as ``flow_setup``'s ``setup.json``) and "
"starts the TCP server class;"
msgstr ""

#: 15dae71f4c1243ecb188218cd72eb7c2 PyFlow.transfer_web.setup_server:8 of
msgid "present  -> starts the TCP server class directly from the saved config."
msgstr ""

#: 921ebc855440467cacd9d366085db41a PyFlow.transfer_web.setup_server:10 of
msgid ""
"After the TCP server is up, the lightweight Flask backend serves the "
"status page and the client-facing API (``/api/server_info`` etc.) on the "
"server's address.  Anonymous visitors also get the landing page with the "
"registration and password-reset flows; accounts live in the SQLite store "
"``.Flow_Web/flow_web.db``, and the verification mails are sent through "
"the mailbox configured in ``.Flow_Web/email_config.json``."
msgstr ""

#: 2f09f9248b0e47e3ba9c9792d83a622b PyFlow.transfer_web.setup_server.main:1 of
msgid "Start the server web backend and serve its UI."
msgstr ""

