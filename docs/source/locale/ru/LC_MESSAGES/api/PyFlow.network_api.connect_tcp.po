msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.interactive_mode:3
#: d91a5c812cdb4705a2fa27ac33ef693a of
msgid ""
"``/quit`` closes the connection; ``/send_msg``, ``/file``, "
"``/multiple_file``, ``/file_folder``, ``/multiple_file_folder``, "
"``/forward_file``, ``/forward_folder`` and ``/forward_send_msg`` are "
"handled locally; any other name goes to the handlers registered with "
"``where_to_run=\"client\"``, and anything left is sent to the server as "
"it stands. Ctrl-C and EOF close the connection."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_file_console:1
#: dc2c54034ec64b61a3af655e86bc81a2 of
msgid ""
"/forward_file <file1> <file2> ... <addr1> <addr2> ... [dest] (client "
"only)."
msgstr ""

#: 303ae7e9e20444e38b303177bef0fb36
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_folder_console:1 of
msgid ""
"/forward_folder <folder1> <folder2> ... <addr1> <addr2> ... [dest] "
"(client only)."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.close:1
#: ec2b9ff3c5cf4fb5a79e29242221fe67 of
msgid "Close the connection and release everything the client owns."
msgstr ""

#: 43645acb6c524c348b870d288aafae5e
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.close:3 of
msgid ""
"Stops the receive loop, releases the port range, flushes the message and "
"event stores and closes the socket. Safe to call more than once."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.start_TCP_client:1
#: afb1904037404a6c99f6b7ae2df119e2 of
msgid "Connect to the server and start the client loop."
msgstr ""

#: 6f912c76416e4f37a750eda0c126da35
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.start_TCP_client:3 of
msgid ""
"Enters `interactive_mode` when ``is_input_command_in_console`` is True, "
"otherwise keeps the process alive while the connection is up. Exits the "
"process with status 1 when the connection cannot be established; Ctrl-C "
"and the end of the connection both run `close`. A client that was closed "
"while still connecting returns quietly, because that stop was asked for."
msgstr ""

