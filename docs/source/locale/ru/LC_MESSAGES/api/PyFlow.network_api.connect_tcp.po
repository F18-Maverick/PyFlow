#: PyFlow.network_api.connect_tcp.TCP_Client_Base.connect:11
#: cd0e7073f18d4d2ba990f1bfda735fd4 of
msgid ""
"enabled, the key exchange has been started); False when the attempt "
"failed or the mode negotiation closed the connection."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.receive_messages:1
#: b7b9e013f50348379a0208a7702b9b1f of
