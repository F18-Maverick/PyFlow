#: ../../source/Network_APIs/TCP_Client_APIs.rst:526
#: 16b438ba77f945d2a68bb24f97a69ef5
msgid "``/file <file_path>``: starts a file transfer from client to server."
msgstr "``/file <file_path>``: 클라이언트에서 서버로 파일 전송을 시작합니다."

#: ../../source/Network_APIs/TCP_Client_APIs.rst:527
#: 65a2f7cca5684f21ae85deaf2675b2fa
#, fuzzy
msgid ""
"``/multiple_file <file1> <file2> ...``: sends multiple files from client "
