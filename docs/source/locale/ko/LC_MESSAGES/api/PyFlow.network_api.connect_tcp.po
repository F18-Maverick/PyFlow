#: PyFlow.network_api.connect_tcp.TCP_Client_Base.connect:1
#: d2fb2a89dc2348c7aae2999441978f12 of
msgid "Connect to the server and start reading from it."
msgstr ""

#: 72f7217f074f41f784472cd285265c75
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.connect:3 of
msgid ""
"Binds ``client_port`` when one was configured, then retries while "
"``is_wait_server`` is True and the server is not reachable yet. Once the "
"socket is up the receive thread is started and the encryption mode is "
"negotiated, which closes the connection when the two sides disagree."
msgstr ""

#: 960df3b5e1a847689ab74ae0308e6d43
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.connect:8 of
msgid ""
"True when the connection is established (and, if encryption is     "
"enabled, the key exchange has been started); False when the attempt     "
"failed or the mode negotiation closed the connection."
msgstr ""

#: 9baaee6195e74bd9ab4aafa8bc44edeb
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.connect:10 of
msgid "True when the connection is established (and, if encryption is"
msgstr ""

#: 6713eea662de4fe39bf04979e026ff7e
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.connect:11 of
msgid ""
"enabled, the key exchange has been started); False when the attempt "
"failed or the mode negotiation closed the connection."
msgstr ""

#: 4f330fdf81b841fca04e6cf5d60f9a2b
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.receive_messages:1 of
msgid "Read from the server until the connection ends."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.receive_messages:3
#: e9a0068978a24ccdbfad454acecd926c of
msgid ""
"Runs on the receive thread: plain lines are reported to the message "
"listeners and stored in ``messages_dict`` (``/send_msg_from`` envelopes "
"are attributed to their sender first), other ``/`` lines go to "
"`handle_server_command`. Any end of the connection clears ``running`` and"
" releases the port range."
msgstr ""

#: 7d784bae869a4f43ad12ffd152856f6d
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.send_message:1 of
msgid "Write one line to a socket, encrypting when the channel is up."
msgstr ""

#: 0aca34a34ecc4b359f8fcc4b1776afd4
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.send_message:3 of
msgid "Target connection; the client passes ``self.client_socket``."
msgstr ""

#: 8a54bbb4a03b4846b0323722dbc913d8
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.send_message:10 of
msgid ""
"True when the payload was written; False when the client is not     "
"running, no socket was passed, or the payload type is unsupported."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.send_message:12
#: c27b9938af014a728f9978ba297940d2 of
msgid "True when the payload was written; False when the client is not"
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.send_message:13
#: e38157baffe644068f3bd12a9e01266c of
msgid "running, no socket was passed, or the payload type is unsupported."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.send_message_to_server:1
#: c39eeb097fcc477a85d8ee7f93c9e66a of
msgid "Send the payload of a console line to the server."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.send_message_to_server:3
#: e7f0180d30454529b646b1e6f697dd70 of
msgid ""
"Console line such as ``/send_msg hello``; the first token (the command "
"name) is dropped and the second one is sent."
msgstr ""

#: 74af846da90b4d39a1a1cf6e60c3a9fd
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.send_message_to_server:7 of
msgid "If the line has fewer than two tokens."
msgstr ""

#: 2bc641c1c3b14338875ba41e9cfa0aa9
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.receive_message:1 of
msgid "Read up to ``msg_length`` bytes from a socket."
msgstr ""

#: 9f82ff84e5924d6f85c5c83e403763e9
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.handle_server_command:1 of
msgid "Dispatch one command line pushed by the server."
msgstr ""

#: 3a32c7bd26354d609d0febdf2672ac3f
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.handle_server_command:3 of
msgid ""
"Handles the protocol's own lines: ``/crypto_mode`` (a mismatch closes the"
" connection), ``/client_alloc_port_range``, the ``/crypto_*`` exchange "
"lines, and the transfer lines ``/file``, ``/file_folder``, "
"``/forward_upload``, ``/pause_trans``, ``/start_trans``, "
"``/forward_error``. Any other name goes to the handlers registered for "
"the \"server\" side via `register_command`; an unknown command is only "
"reported on the console."
msgstr ""

#: 43e1dd509ff94b23946534ae5c18a610
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_messages:1 of
msgid "Forward plain messages to other connected clients through the server."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_messages:3
#: e399427cf6cf44bb9aabc0e79b3c5ef9 of
msgid ""
"The console command ``/forward_send_msg`` uses this; the client must be "
"connected. The server wraps each message in a ``/send_msg_from`` envelope"
" so the receiving client can attribute it back to this one."
msgstr ""

#: 80214c34024243e7bdaccfb4684fee44
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_messages:7 of
msgid "Message texts to forward."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_messages:9
#: d9d583bae0614ac8b0ab935c13ef60fb of
msgid "Destination ``(ip, port)`` tuples."
msgstr ""

#: 2de70db00505478f9fbd1bf62dcd26db
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_messages:12 of
msgid ""
"True when the request was written to the server; False when the     "
"client is not connected."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_messages:14
#: dc7ee1e53ec94b8c9d8d97907c76f07f of
msgid "True when the request was written to the server; False when the"
msgstr ""

#: 588dcd4373804514912e7d87fdfa53bf
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_messages:15 of
msgid "client is not connected."
msgstr ""

#: 0c8b3072ec3a47c1b9db2863a74f1541
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.interactive_mode:1 of
msgid "Read console lines and act on them until the client stops."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.interactive_mode:3
#: f8edfe7589d0497e9c8eda287e307383 of
msgid ""
"``/quit`` closes the connection; ``/send_msg``, ``/file``, "
"``/multiple_file``, ``/file_folder``, ``/multiple_file_folder``, "
"``/forward_file``, ``/forward_folder`` and ``/forward_send_msg`` are "
"handled locally; any other name goes to the handlers registered with "
"``where_to_run=\"client\"``, and anything left is sent to the server as "
"it stands. Ctrl-C and EOF close the connection."
msgstr ""

#: 6c9948ee60584e9397640810ce2f4188
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_file_console:1 of
msgid ""
"/forward_file <file1> <file2> ... <addr1> <addr2> ... [dest] (client "
"only)."
msgstr ""

#: 62e44fe77b2349f69563b905928bbcd4
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_folder_console:1 of
msgid ""
"/forward_folder <folder1> <folder2> ... <addr1> <addr2> ... [dest] "
"(client only)."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.close:1
#: c798a1e8b27746deb8df30947f85b6d8 of
msgid "Close the connection and release everything the client owns."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.close:3
#: ef72a619173741b6b1897a1f5364b09e of
msgid ""
"Stops the receive loop, releases the port range, flushes the message and "
"event stores and closes the socket. Safe to call more than once."
msgstr ""

#: 8eab54b29cff494081d8d3c3a53ca3f5
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.start_TCP_client:1 of
msgid "Connect to the server and start the client loop."
msgstr ""

#: 41ee5abbfa0b4e4099bb5b901c59460c
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.start_TCP_client:3 of
msgid ""
"Enters `interactive_mode` when ``is_input_command_in_console`` is True, "
"otherwise keeps the process alive while the connection is up. Exits the "
"process with status 1 when the connection cannot be established; Ctrl-C "
"and the end of the connection both run `close`."
msgstr ""

