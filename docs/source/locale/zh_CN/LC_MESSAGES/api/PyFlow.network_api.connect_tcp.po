msgstr ""

#: 793bcfd02c014200b0ec47f8e15b4d91
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.interactive_mode:3 of
msgid ""
"``/quit`` closes the connection; ``/send_msg``, ``/file``, "
"``/multiple_file``, ``/file_folder``, ``/multiple_file_folder``, "
"``/forward_file``, ``/forward_folder`` and ``/forward_send_msg`` are "
"handled locally; any other name goes to the handlers registered with "
"``where_to_run=\"client\"``, and anything left is sent to the server as "
"it stands. Ctrl-C and EOF close the connection."
msgstr ""

#: 7ba721f9d59742b99e89e3b6e249e754
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.file_transfer_mode:13 of
msgid ""
"``peer`` is the transfer's original receiver (the target of a forward, "
"never the relay): it is stored with the progress entry so a later "
"reconnect can be resumed. ``resume_offset`` continues an interrupted "
"transfer from the byte the receiver already holds: the file is read from "
"there instead of its first byte."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.resume_transfers:3
#: a3c59554b8de41b280df7536b307bed0 of
msgid ""
"Reads the persisted stores back (`_load_transfer_progress`) and drives "
"every download that can be continued: a file the server was sending is"
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.resume_transfers:6
#: fae378e888be4821a14ed2483cfde1e0 of
msgid ""
"Peer ``(ip, port)`` that just connected; None resumes every peer the "
"client can reach."
msgstr ""

#: 48061103ed9d4bcaae8a8a837b363557
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.resume_transfers:10 of
msgid "Number of resumed transfers started or requested."
msgstr ""

#: 6dbae803a56c442588b28af664b7a0e9
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_file_console:1 of
msgid ""
"/forward_file <file1> <file2> ... <addr1> <addr2> ... [dest] (client "
"only)."
msgstr ""

#: 05cad8b03e0747dc804ffbfda3122fe1
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.forward_folder_console:1 of
msgid ""
"/forward_folder <folder1> <folder2> ... <addr1> <addr2> ... [dest] "
"(client only)."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.file_transfer_mode_recv:3
#: f6f606236f434f0287a969ccbe5ba2c5 of
msgid ""
"``peer`` is the transfer's original sender (the server for a pushed file,"
" the originating client for a forwarded one — never the relay): it is "
"stored with the progress entry so a later reconnect can ask that peer to "
"continue the file."
msgstr ""

#: 6e9a9717a782419baecca63fd1f46baf
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.close:1 of
msgid "Close the connection and release everything the client owns."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.close:3
#: ba6c5badecf6465db6036735870ed305 of
msgid ""
"Stops the receive loop, releases the port range, flushes the message and "
"event stores, persists the interrupted transfers and closes the socket. "
"Safe to call more than once."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.start_TCP_client:1
#: c91a3245b93f46abbb49dbef7bcfeb1c of
msgid "Connect to the server and start the client loop."
msgstr ""

#: 0c83552867484ea780fcff8d34e5c2d8
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.start_TCP_client:3 of
msgid ""
"Enters `interactive_mode` when ``is_input_command_in_console`` is True, "
"otherwise keeps the process alive while the connection is up. Exits the "
"process with status 1 when the connection cannot be established; Ctrl-C "
"and the end of the connection both run `close`. A client that was closed "
"while still connecting returns quietly, because that stop was asked for."
msgstr ""

#: PyFlow.network_api.connect_tcp.TCP_Client_Base.start_TCP_client:9
#: eec663f58484446ebce460e6402d7b5f of
msgid ""
"With ``is_auto_reconnect`` True a dropped connection does not end the "
"client: it reconnects (waiting for the server when ``is_wait_server`` is "
"set) and every session carries the interrupted transfers of the previous "
"one (`resume_transfers`). A close or ``/quit`` still stops the client."
msgstr ""

