#: PyFlow.network_api.connect_tcp.TCP_Client_Base.file_transfer_mode:3
#: PyFlow.network_api.connect_tcp.TCP_Server_Base.file_transfer_mode:3
#: d6a618c007ec433fa10a44b0a7a90fe4 of
msgid ""
"``control_socket``/``crypto`` carry the listener's mode stamp (\"plain\" "
"or \"enc:<nonce>\"): an encrypted leg aborts when the session key "
"material is missing rather than downgrading silently."
msgstr ""

#: 97e1a0538f544c2a8e755c78805fda7c
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.file_transfer_mode:7
#: PyFlow.network_api.connect_tcp.TCP_Server_Base.file_transfer_mode:7
#: a405431dfd62434b82c7052edc456123 of
msgid ""
"``fid`` is the transfer's id — the caller's own transfer id for a plain "
"send, the relay id for a forwarded upload — and keys this leg in "
"``file_upload_progress``; every leg with a fid can be paused with "
"``/pause_trans`` for that fid. None (a leg without a protocol transfer "
"id, such as a public-key push) tracks no progress."
msgstr ""

#: 6cb58bfd1dde4b49ba3525af014e44c7
#: PyFlow.network_api.connect_tcp.TCP_Server_Base.file_transfer_mode:13 of
msgid ""
"``peer`` is the transfer's original receiver (never a relay): it is "
"stored with the progress entry so a later reconnect can be resumed. "
"``resume_offset`` continues an interrupted transfer from the byte the "
"receiver already holds: the file is read from there instead of its first "
"byte."
msgstr ""

#: 1634dbe84a95421a92a660f7c6fdd10e
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.resume_transfers:1
#: PyFlow.network_api.connect_tcp.TCP_Server_Base.resume_transfers:1 of
