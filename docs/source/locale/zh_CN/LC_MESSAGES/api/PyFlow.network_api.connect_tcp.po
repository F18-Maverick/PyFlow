#: PyFlow.network_api.connect_tcp.TCP_Server_Base.file_transfer_mode_recv:3
#: d3367c6f97aa4bf4b9cb3d79b3117fce of
msgid ""
"``peer`` is the transfer's original sender (the sender for an inbound "
"transfer, never a relay): it is stored with the progress entry so a later"
" reconnect can ask that peer to continue the file."
msgstr ""

#: 5c4faf52e8bb4808805bae58d30ac0cc
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.file_transfer_mode_recv:8
#: PyFlow.network_api.connect_tcp.TCP_Server_Base.file_transfer_mode_recv:7
#: de641d48c530435bb4adc04755a47a6d of
msgid ""
"``resume_entry`` continues an interrupted transfer: the listener "
"announces itself, asks the sender to continue from the bytes already on "
"disk (``RESUME_LINE``) and appends the incoming chunks to the partial "
"file instead of truncating it."
msgstr ""

#: 51eade0145d74a2bbfc51070bc779703
#: PyFlow.network_api.connect_tcp.TCP_Client_Base.file_transfer_mode:1
#: PyFlow.network_api.connect_tcp.TCP_Server_Base.file_transfer_mode:1 of
