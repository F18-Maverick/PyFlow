#: 2f786e174934474a93c6498878a68612 PyFlow.transfer_web.setup_client:1 of
msgid "PyFlow TCP client web launcher."
msgstr ""

#: 24fa9f33454d4afc9d15c80a0299922d PyFlow.transfer_web.setup_client:3 of
msgid ""
"Starts a lightweight Flask backend on 127.0.0.1 and opens the connect UI "
"in the browser.  The user enters the server address (an http/https domain"
" or a bare IP); the backend asks the server's web backend for the TCP "
"server address/port, starts the TCP client, and keeps the backend running"
" to relay the user's frontend actions.  A server that needs accounts (a "
"verification mailbox is configured) makes the same backend log in: saved "
"credentials in ``.Flow_Web/client_login.json`` are replayed on every "
"start, and the login window appears whenever no session could be "
"restored.  A server without a mailbox needs no accounts, so the login "
"window and the account controls are skipped."
msgstr ""

#: PyFlow.transfer_web.setup_client.main:1 ca4ce7c686c84b44ae429e4de15b9afd of
msgid "Start the client web backend and serve its UI."
msgstr ""

