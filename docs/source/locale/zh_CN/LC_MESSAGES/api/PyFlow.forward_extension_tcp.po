msgid ""
"Create and start a forwarding-capable client (mirrors the control "
"extension)."
msgstr ""

#: 99ee11955438459d84f5c1ae6f3fedbb PyFlow.forward_extension_tcp.server_setup:1
#: of
msgid ""
"Create and start a forwarding-capable server (mirrors the control "
